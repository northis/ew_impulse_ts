# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# cTrader account (cTID)
# ---------------------------------------------------------------------------
# Your cTrader ID (username or email). NOT the broker login, NOT the password.
CTID=
# Trading account number (the digits shown for the account in cTrader).
ACCOUNT=
# Anchor chart the cBot instance is attached to. The full list of traded symbols
# is the bot's own "SymbolsToProceed" parameter (see README for overrides).
SYMBOL=EURUSD
PERIOD=m5

# Optional: container timezone.
TZ=UTC

# ---------------------------------------------------------------------------
# Mode: live | backtest
# ---------------------------------------------------------------------------
# live     = run the bot for real (default).
# backtest = run cTrader CLI's backtest over the date range below (debugging,
#            no real orders). See README section "Режим бектеста".
MODE=backtest

# Backtest settings (used only when MODE=backtest).
# Date range format: dd/MM/yyyy [hh:mm] (UTC).
BACKTEST_START=01/07/2026 00:00
BACKTEST_END=31/07/2026 23:59
# Data mode: open | m1 | m1-csv | tick-csv | ticks
BACKTEST_DATA_MODE=m1
# Optional overrides (uncomment to use):
# BACKTEST_BALANCE=10000
# BACKTEST_SPREAD=1
# BACKTEST_COMMISSION=30
# BACKTEST_DATA_FILE=/mnt/algo/history.csv

# NOTE: cBot parameters (Telegram token, ChatId, AllowToTrade, risk, symbols,
# diagonal filters, etc.) are in parameters.cbotset (copy
# parameters.cbotset.example -> parameters.cbotset and edit).

# ---------------------------------------------------------------------------
# cTID password -> NOT here. Put it into ./secrets/ctrader-cli.pwd (single line,
# no spaces). cTrader CLI reads the password from a file (--pwd-file) by design
# and explicitly warns against putting it in env vars / command line.
# ---------------------------------------------------------------------------
