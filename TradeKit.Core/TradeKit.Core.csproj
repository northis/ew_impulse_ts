<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<Version>1.3.0</Version>
	<Authors>Mikhail Berdnikov</Authors>
	<Copyright>Mikhail Berdnikov (C) 2025</Copyright>
	<RepositoryUrl>https://github.com/northis/ew_impulse_ts</RepositoryUrl>
	<Product>Trading Kit</Product>
	<Description>Trading Kit Core Library</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ML\**" />
    <EmbeddedResource Remove="ML\**" />
    <None Remove="ML\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Plotly.NET.ImageExport" Version="6.1.0" />
    <PackageReference Include="SharpZipLib" Version="1.3.3" />
    <PackageReference Include="SkiaSharp" Version="3.0.0-preview.5.4" />
    <!-- Must be the fontconfig-linked build, NOT .NoDependencies: the NoDependencies
         font manager has no charset matching (SKFontManager.MatchCharacter always
         returns null), and Svg.Skia 2.0.0.1 resolves SVG text runs via MatchCharacter
         (SkiaAssetLoader.FindTypefaces) - so every <text> silently renders in the
         default serif face. See deploy/diagonal/Dockerfile for details. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.0.0-preview.5.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.1" />
    <PackageReference Include="System.Text.Encodings.Web" Version="4.5.1" />
    <PackageReference Include="Telegram.Bot" Version="17.0.0" />
    <PackageReference Include="WTelegramClient" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\ResHolder.Designer.cs">
      <DependentUpon>ResHolder.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResHolder.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>ResHolder.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Stamps the HEAD commit into the library, so every build flavour (VS, dotnet CLI,
       cTrader CLI in Docker) reports the same source revision instead of the assembly
       version. Environments without a git executable can pass the values in through the
       TradeKitGitCommit / TradeKitGitCommitDate properties or environment variables. -->
  <Target Name="EmbedGitInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GitInfoFile>$(IntermediateOutputPath)GitInfo.g.cs</GitInfoFile>
      <!-- Exec runs through cmd on Windows, which swallows a lone '%' of the git format. -->
      <_GitDateFormat Condition="'$(OS)' == 'Windows_NT'">%%cI</_GitDateFormat>
      <_GitDateFormat Condition="'$(OS)' != 'Windows_NT'">%cI</_GitDateFormat>
    </PropertyGroup>

    <Exec Condition="'$(TradeKitGitCommit)' == ''"
          Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMsBuild="true" EchoOff="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="TradeKitGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitCommitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitCommitExitCode)' != '' and '$(_GitCommitExitCode)' != '0'">
      <TradeKitGitCommit />
    </PropertyGroup>

    <Exec Condition="'$(TradeKitGitCommitDate)' == ''"
          Command="git -C &quot;$(MSBuildProjectDirectory)&quot; show -s --format=$(_GitDateFormat) HEAD"
          ConsoleToMsBuild="true" EchoOff="true" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="TradeKitGitCommitDate" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDateExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitDateExitCode)' != '' and '$(_GitDateExitCode)' != '0'">
      <TradeKitGitCommitDate />
    </PropertyGroup>

    <PropertyGroup>
      <_GitInfoContent><![CDATA[// <auto-generated /> Written by the EmbedGitInfo target of TradeKit.Core.csproj.
namespace TradeKit.Core.Common
{
    internal static class GitInfo
    {
        public const string Commit = "$(TradeKitGitCommit.Trim())";
        public const string CommitDate = "$(TradeKitGitCommitDate.Trim())";
    }
}]]></_GitInfoContent>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(GitInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$([MSBuild]::Escape($(_GitInfoContent)))" />
    <ItemGroup>
      <Compile Include="$(GitInfoFile)" />
      <FileWrites Include="$(GitInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
